# Copy to .env.local (git-ignored). Leave every value blank to run on mock
# data — that is the normal state, and every preview deployment runs that way.
#
# Corrected 2026-11-13. Four names here did not match what the code reads, so
# anyone following this file got a silent no-op and would have concluded the
# integration was broken (SERVICES_AUDIT.md finding 1). The list below is now
# exactly what `grep -rhoE 'process\.env\.[A-Z_]+' apps packages scripts`
# returns, and SERVICES_AUDIT.md records the same set.
#
# If you already have a .env.local using the old names, rename:
#   NEXT_PUBLIC_SUPABASE_URL  ->  SUPABASE_URL
#   STRIPE_SECRET_KEY         ->  STRIPE_TEST_SECRET_KEY
#   N8N_BASE_URL              ->  N8N_WEBHOOK_URL   (a webhook URL, not a base)

# --- Read by the code today --------------------------------------------------

# Supabase. Both are needed together: a URL with no key cannot write anything.
# Server-side only, and deliberately not NEXT_PUBLIC_* — the service-role key
# must never reach a browser, and there is no browser client to give one to.
# Without these, the lead store writes to .data/niche-scans.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode only. The name says TEST on purpose: a live key cannot be
# supplied out of habit, and lib/billing/checkout.ts rejects anything that does
# not start with sk_test_ (there is a unit test holding that). CLAUDE.md
# non-negotiable 11: no paid API calls beyond test mode.
STRIPE_TEST_SECRET_KEY=

# n8n, for back-office flows. A full webhook URL, not a base URL. Nothing in
# this repo sets it; while it is unset, notifyN8n returns false and the lead is
# still stored.
N8N_WEBHOOK_URL=

# The co-pilot's model key. Moved up from "not read by anything yet" on
# 15 November, when PR C1 landed lib/copilot: adapter.ts is the only module
# that reads it, and it is server-side only — it never reaches a browser
# bundle, and a test walks the import graph to keep it that way.
#
# LEAVING IT BLANK IS A SUPPORTED MODE, NOT A BROKEN ONE (docs/specs/18 §4).
# With no key both co-pilots answer from scripted replies built out of our own
# pages, every route works, the reply says "sample", and nothing touches the
# network. That is what every preview runs, and it is what lets the two UI
# pull requests be built and reviewed before this key exists.
#
# Setting it turns on real calls to claude-haiku-4-5 (website) and
# claude-sonnet-5 (studio), which cost money — see the cap below.
# The agents are still fixtures; nothing else calls the API.
ANTHROPIC_API_KEY=

# The co-pilot's hard spend cap, per workspace, per calendar month, in dollars.
# Defaults to 20 when unset, and a value that is not a positive number is
# ignored rather than trusted — a typo must not become an unlimited budget.
# The cap is checked before each call and the call is not made if it would
# cross it (non-negotiable 11).
COPILOT_MONTHLY_CAP_USD=

# --- Set on the command line, not here ---------------------------------------
# SCREENSHOT_OUT_DIR  where `pnpm screenshots` writes, e.g.
#                     SCREENSHOT_OUT_DIR=docs/screens-built/before-v4
# CI                  set by the CI runner; changes Playwright's retries
#
# Removed 2026-11-13, because nothing read them: NEXT_PUBLIC_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, N8N_API_KEY. The two NEXT_PUBLIC_ ones
# were worse than unused — they invited someone to wire up a browser client
# this app does not have. They come back when there is one.
