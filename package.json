{
  "name": "mirrorline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs --live",
    "build": "pnpm --filter @mirrorline/web build",
    "start": "pnpm --filter @mirrorline/web start",
    "lint": "pnpm --filter @mirrorline/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:copilot-live": "vitest run --config vitest.live.config.ts",
    "test:rls-db": "vitest run --config vitest.db.config.ts",
    "screenshots": "playwright test --project=screenshots",
    "licence-check": "node scripts/licence-check.mjs",
    "design:lint": "npx --yes @google/design.md lint DESIGN.md"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.5",
    "sharp": "^0.35.5",
    "typescript": "5.7.3",
    "vitest": "5.1.0"
  }
}
