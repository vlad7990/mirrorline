{
  "name": "mirrorline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mirrorline/web dev",
    "build": "pnpm --filter @mirrorline/web build",
    "start": "pnpm --filter @mirrorline/web start",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "licence-check": "node scripts/licence-check.mjs",
    "design:lint": "npx --yes @google/design.md lint DESIGN.md"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "5.1.0"
  }
}
