{
  "env": {
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force"
  },
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease:*)"
    ],
    "deny": [
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel promote*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push upstream main*)",
      "Bash(git reset --hard*)",
      "Bash(stripe * --live*)",
      "Bash(supabase db reset --linked*)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)"
    ]
  }
}
